+        encoded_query = urllib.parse.urlencode(query)
+        secsdk_signature = hashlib.md5(f'{uifid}_{timestamp}_{salt}_{encoded_query}'.encode()).hexdigest()
+        return {**query, 'x-secsdk-web-signature': secsdk_signature}
