# 访问
APP_BIND=127.0.0.1
APP_PORT=18092
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-random-64-characters
SECURE_COOKIE=false
POSTGRES_PASSWORD=replace-with-random-database-password

# 视频与保留策略
MAX_UPLOAD_MB=2048
SOURCE_RETENTION_HOURS=24
JOB_TIMEOUT_SECONDS=21600

# 默认 ASR：小米 MiMo-V2.5-ASR
ASR_PROVIDER=mimo
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-asr
ASR_LANGUAGE=auto
ASR_CHUNK_SECONDS=180
URL_AUDIO_ONLY_MINUTES=45
DOUYIN_COOKIE_FILE=/data/secrets/douyin-cookies.txt
VISUAL_MAX_FRAMES=48
VISUAL_MIN_INTERVAL_SECONDS=4

# 自定义 OpenAI Whisper 兼容 ASR（ASR_PROVIDER=custom 时启用）
CUSTOM_ASR_BASE_URL=
CUSTOM_ASR_API_KEY=
CUSTOM_ASR_MODEL=whisper-1

# AssemblyAI（支持多人对话说话人标记；ASR_PROVIDER=assemblyai 时启用）
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-2

# Sub2API：仅在点击“找亮点”或“复刻改编”后调用
SUB2API_BASE_URL=
SUB2API_API_KEY=
SUB2API_FALLBACK_API_KEY=
LLM_PRIMARY_MODEL=gemini-2.5-pro
LLM_FALLBACK_MODEL=gpt-5.4
